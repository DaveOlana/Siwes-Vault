generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  placements   Placement[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Placement {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentName               String
  matricNo                  String
  department                String
  companyName               String
  industrySupervisorName    String
  startDate                 DateTime @db.Date
  institutionName           String?
  levelOrProgramme          String?
  companyAddress            String?
  companySector             String?
  assignedUnit              String?
  institutionSupervisorName String?
  isActive                  Boolean  @default(true)
  weeks                     Week[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([userId])
}

model Week {
  id              String       @id @default(cuid())
  placementId     String
  placement       Placement    @relation(fields: [placementId], references: [id], onDelete: Cascade)
  weekNumber      Int
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  diagramUrl      String?
  diagramPublicId String?
  diagramSource   String?
  entries         DailyEntry[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([placementId, weekNumber])
}

model DailyEntry {
  id              String    @id @default(cuid())
  weekId          String
  week            Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  slotIndex       Int
  dayNumber       Int
  activityDate    DateTime  @db.Date
  weekdayName     String
  activitySummary String?
  toolsUsed       String[]  @default([])
  keyTakeaway     String?
  loggedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([weekId, dayNumber])
  @@index([activityDate])
}
